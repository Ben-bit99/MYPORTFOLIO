# ─────────────────────────────────────────────────────────────
#  Portfolio AI assistant (RAG chatbot)
#  Copy to .env.local and fill in ONE provider key.
#  Without a key the chatbot still works in "offline mode":
#  it answers with the most relevant portfolio excerpts (no LLM).
# ─────────────────────────────────────────────────────────────

# "google" (default) or "openai"
AI_PROVIDER=google

# Google Gemini — https://aistudio.google.com/app/apikey
GOOGLE_GENERATIVE_AI_API_KEY=

# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Optional model overrides (defaults shown)
# Google: CHAT_MODEL=gemini-3.8-flash   EMBEDDING_MODEL=gemini-embedding-001
# OpenAI: CHAT_MODEL=gpt-4.1-mini       EMBEDDING_MODEL=text-embedding-3-small
CHAT_MODEL=
EMBEDDING_MODEL=

# Requests per minute per IP for /api/chat (default 15)
CHAT_RATE_LIMIT_PER_MIN=15

# Public site URL, used for Open Graph / canonical metadata
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─────────────────────────────────────────────────────────────
#  Guestbook ("Room of Echoes")
#  Local dev saves to .data/memories.json automatically.
#  On Vercel/serverless, add a free Upstash Redis database:
# ─────────────────────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Secret for deleting memories via DELETE /api/memories?id=…
MEMORIES_ADMIN_TOKEN=
# Optional: extra blocked words, comma-separated
MEMORIES_BLOCKLIST=
# Optional: posts per IP per 10 minutes (default 3)
MEMORIES_PER_10_MIN=3

# ─────────────────────────────────────────────────────────────
#  Contact form (email). Put REAL values only in .env.local
#  (never commit it). Without these, the form shows a friendly
#  "not configured yet" message and suggests emailing directly.
# ─────────────────────────────────────────────────────────────
# "smtp" (default) or "resend"
EMAIL_PROVIDER=smtp

# Gmail via SMTP (recommended):
#  1. Turn on 2-Step Verification for your Google account.
#  2. Create an App Password: Google Account → Security → App passwords.
#  3. Paste the 16-character password below (no spaces).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=abwahib07@gmail.com
SMTP_PASS=

# Or Resend (https://resend.com): EMAIL_PROVIDER=resend + an API key.
# With the default sender (onboarding@resend.dev), Resend only delivers to
# the email you signed up with — use the same address as CONTACT_TO.
RESEND_API_KEY=

# Where messages are delivered (defaults to the portfolio email) and the sender name
CONTACT_TO=abwahib07@gmail.com
CONTACT_FROM=
# Messages per IP per 10 minutes (default 3)
CONTACT_PER_10_MIN=3
